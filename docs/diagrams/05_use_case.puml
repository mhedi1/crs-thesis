' General use case diagram — deliberately high level.
' Qwen3 runs on the same machine as the web application, so it is inside the
' system boundary. Only the GPU recommender and TMDB are external actors.
@startuml use_case_general
left to right direction

skinparam backgroundColor transparent
skinparam shadowing false
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 13
skinparam actorStyle awesome

skinparam actor {
  BorderColor #333333
  BackgroundColor #FFFFFF
  FontColor #111111
}
skinparam usecase {
  BackgroundColor #F4F7FB
  BorderColor #33507A
  FontColor #111111
}
skinparam rectangle {
  BorderColor #999999
  BackgroundColor transparent
  FontColor #555555
  FontSize 12
}

actor "User" as user

rectangle "Conversational Movie Recommender" {
  usecase "Request a movie\nrecommendation" as UC1
  usecase "Ask a follow-up about\nthe current recommendation" as UC2
  usecase "Start a new\nconversation" as UC3
}

actor "Recommendation\nEngine" as engine
actor "Movie Metadata\nService" as tmdb

user -- UC1
user -- UC2
user -- UC3

UC1 -- engine
UC1 -- tmdb

@enduml
